# Primer usuario puede registrarse una vez. Para permitir más usuarios: true.
# Deja false cuando publiques la aplicación, salvo que controles las invitaciones.
LEGACYLIFT_ALLOW_REGISTRATION=false
# Requerido SOLO para registrar el primer usuario. Debe ser aleatorio, 24+ caracteres.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LEGACYLIFT_BOOTSTRAP_SECRET=REPLACE_WITH_RANDOM_BOOTSTRAP_SECRET
LEGACYLIFT_DATA_DIR=./data
# codex | claude | demo se elige por proyecto en la UI.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CODEX_BIN=codex
# Por defecto NO ejecuta codigo del repositorio cargado.
# static = sintaxis/estructura; docker = Python unittest aislado (requiere Docker).
VALIDATION_MODE=static
# Solo para origin distinto al propio servidor en desarrollo:
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Sprint 1 — GitHub OAuth App (repo scope: accesos públicos y privados)
# Callback definido al registrar la OAuth App. Para acceso externo exige HTTPS.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/github/callback
GITHUB_OAUTH_RETURN_URL=http://localhost:4200/?github=connected
# Genera: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEGACYLIFT_ENCRYPTION_KEY=
